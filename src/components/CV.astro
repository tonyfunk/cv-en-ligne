---
import {
  profile, contact, stats, experience, skills, education, languages, ui, t, type Lang,
} from "../data/cv";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === "fr" ? "/en/" : "/";

// Allow **bold** in bullets; everything else is escaped.
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const rich = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");

const hasContact = Boolean(contact.email || contact.linkedin);
const year = new Date().getFullYear();
---

<a class="skip" href="#main">{lang === "fr" ? "Aller au contenu" : "Skip to content"}</a>

<header class="nav">
  <div class="wrap nav-inner">
    <a href={lang === "fr" ? "/" : "/en/"} class="brand" aria-label={profile.name}>
      <span class="brand-mark">AL</span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <nav aria-label="Sections">
      <a href="#experience">{t(ui.nav.experience, lang)}</a>
      <a href="#skills">{t(ui.nav.skills, lang)}</a>
      <a href="#contact">{t(ui.nav.contact, lang)}</a>
    </nav>
    <a class="lang" href={other} hreflang={lang === "fr" ? "en" : "fr"} aria-label={t(ui.switchLangLabel, lang)}>
      {t(ui.switchLang, lang)}
    </a>
  </div>
</header>

<main id="main">
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="pill reveal"><span class="dot" aria-hidden="true"></span>{t(profile.available, lang)}</p>
      <h1 class="reveal">
        <span class="hero-name">{profile.name}</span>
        <span class="hero-role">{t(profile.role, lang)}</span>
      </h1>
      <p class="hero-headline reveal">{t(profile.headline, lang)}</p>
      <p class="hero-summary reveal">{t(profile.summary, lang)}</p>
      <p class="print-only print-contact">
        {[t(profile.location, lang), contact.email, contact.linkedin?.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")]
          .filter(Boolean).join("  ·  ")}
      </p>
      <div class="actions reveal">
        <a class="btn btn-primary" href="#contact">
          {t(ui.contactMe, lang)}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
        <a class="btn btn-ghost" href={t(contact.pdf, lang)} download>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13h10" /></svg>
          {t(ui.downloadCv, lang)}
        </a>
        {contact.linkedin && (
          <a class="btn btn-icon" href={contact.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="fill"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        )}
      </div>
    </div>
    <div class="hero-photo reveal">
      <div class="photo-frame">
        <img src={profile.photo} alt={profile.name} width="640" height="640" fetchpriority="high" />
      </div>
      <p class="photo-meta">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14s5-4.2 5-8A5 5 0 0 0 3 6c0 3.8 5 8 5 8z"/><circle cx="8" cy="6" r="1.6"/></svg>
        {t(profile.location, lang)}
      </p>
    </div>
  </section>

  <!-- STATS -->
  <section class="wrap stats" aria-label={lang === "fr" ? "Chiffres clés" : "Key numbers"}>
    {stats.map((s) => (
      <div class="stat reveal">
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{t(s.label, lang)}</span>
      </div>
    ))}
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="wrap section">
    <div class="section-head reveal">
      <p class="kicker">{t(ui.experienceKicker, lang)}</p>
      <h2>{t(ui.experienceTitle, lang)}</h2>
    </div>

    <ol class="timeline">
      {experience.map((job) => (
        <li class="job reveal">
          <div class="job-logo" aria-hidden="true">{job.logo}</div>
          <div class="job-body">
            <div class="job-head">
              <h3>{t(job.company, lang)}</h3>
              {job.current && <span class="badge">{t(ui.current, lang)}</span>}
              <span class="job-loc">{t(job.location, lang)}</span>
            </div>
            {job.roles.map((role) => (
              <div class="role">
                <div class="role-head">
                  <p class="role-title">{t(role.title, lang)}</p>
                  <p class="role-dates">{t(role.dates, lang)}</p>
                </div>
                {role.bullets && (
                  <ul class="bullets">
                    {role.bullets[lang].map((b) => <li set:html={rich(b)} />)}
                  </ul>
                )}
              </div>
            ))}
            {job.tags && (
              <ul class="tags" aria-label="Tags">
                {job.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="wrap section">
    <div class="section-head reveal">
      <p class="kicker">{t(ui.skillsKicker, lang)}</p>
      <h2>{t(ui.skillsTitle, lang)}</h2>
    </div>
    <div class="skills-grid">
      {skills.map((group) => (
        <div class="card reveal">
          <h3>{t(group.title, lang)}</h3>
          <ul class="chips">
            {group.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
      <div class="card reveal">
        <h3>{t(ui.educationTitle, lang)}</h3>
        {education.map((e) => (
          <div class="edu">
            <p class="edu-school">{e.school}</p>
            <p class="edu-degree">{t(e.degree, lang)}</p>
          </div>
        ))}
      </div>
      <div class="card reveal">
        <h3>{t(ui.languagesTitle, lang)}</h3>
        <ul class="langs">
          {languages.map((l) => (
            <li><span>{t(l.name, lang)}</span><span class="muted">{t(l.level, lang)}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="wrap section">
    <div class="cta reveal">
      <h2>{t(ui.contactTitle, lang)}</h2>
      <p>{t(ui.contactText, lang)}</p>
      <div class="actions">
        {contact.email && (
          <a class="btn btn-primary" href={`mailto:${contact.email}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="m2.5 4.5 5.5 4 5.5-4"/></svg>
            {contact.email}
          </a>
        )}
        {contact.linkedin && (
          <a class="btn btn-ghost" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        )}
        <a class="btn btn-ghost" href={t(contact.pdf, lang)} download>{t(ui.downloadCv, lang)} (PDF)</a>
      </div>
      {!hasContact && <p class="todo">⚠ Add email / LinkedIn in src/data/cv.ts</p>}
    </div>
  </section>
</main>

<footer class="wrap footer">
  <p>© {year} {profile.name}</p>
  <p class="muted">{t(ui.photoBy, lang)} © {profile.photoCredit}</p>
</footer>

<script>
  // Fade sections in as they enter the viewport (skipped for reduced-motion users via CSS).
  const els = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    document.documentElement.classList.add("js");
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      }),
      { rootMargin: "0px 0px -8% 0px" },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
